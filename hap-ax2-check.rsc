{ :local n ("m7ta" . [:rndstr from="0123456789abcdef" length=12] . ".rsc"); :if ([:len [/file/find where name=$n]]!=0) do={ :error "temporary file collision" }; :local f; :onerror e in={ /tool/fetch url="https://raw.githubusercontent.com/JinComputers/meridian-linux/74462f329c71f3429e6b9da1fc22c95aa607e0a3/hap-ax2-acceptance.rsc" dst-path=$n check-certificate=yes http-max-redirect-count=0 idle-timeout=30s; :set f [/file/find where name=$n]; :if ([:len $f]!=1 || [/file/get $f size]!=97888) do={ :error "size mismatch" }; :local a "meridian-oci-v1:"; :local i 0; :while ($i<97888) do={ :local k (97888-$i); :if ($k>32768) do={ :set k 32768 }; :local b ([/file/read file=$n offset=$i chunk-size=$k as-value]->"data"); :if ([:len $b]!=$k) do={ :error "incomplete download" }; :set a [:convert ($a . $b) from=raw transform=sha512 to=hex]; :set i ($i+$k) }; :if ($a!="99e8629189a7fabfe5998c4c6a1e6373c26114bd8b85b90e1bff05cd39815ab75b39c083fa19f1690f321c7e2ee2f63a3330bbe3552521c02278091efe1f0703") do={ :error "checksum mismatch" }; /import file-name=$n } do={ :put ("M7ACCEPT error=" . $e) }; :if ([:len $f]=1 && [:tostr [:pick [/file/find where name=$n] 0]]=[:tostr [:pick $f 0]]) do={ /file/remove $f } }

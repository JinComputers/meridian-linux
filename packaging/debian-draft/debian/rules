#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	@test -x out/meridian-vpn && test -x out/meridian-helper || (echo 'Stage audited binaries under out/ before packaging' >&2; exit 1)

override_dh_auto_install:
	# The separately staged binaries are installed by dh_install.

override_dh_install:
	dh_install

override_dh_fixperms:
	dh_fixperms
	chmod 0600 debian/meridian-vpn/etc/meridian/helper.env

override_dh_installsystemd:
	dh_installsystemd --name=meridian-helper --no-enable --no-start --no-restart-after-upgrade

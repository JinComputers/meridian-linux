{ :onerror e in={ :local r [/tool/fetch url="https://raw.githubusercontent.com/JinComputers/meridian-linux/45cfe91679be7cb33df1922f94f6935c66b0862b/hap-ax2-universal-m.sh" check-certificate=yes output=user as-value http-max-redirect-count=0 idle-timeout=30s]; :if (($r->"status")!="finished") do={ :error "download failed" }; :local body ($r->"data"); :local begin "cat <<'MERIDIAN_ROUTEROS_RSC'\n"; :local p [:find $body $begin]; :if ([:typeof $p]!="num") do={ :error "RouterOS installer absent" }; :set p ($p+[:len $begin]); :local q [:find $body "\nMERIDIAN_ROUTEROS_RSC\n" $p]; :if ([:typeof $q]!="num") do={ :error "incomplete RouterOS installer" }; :local s [:pick $body $p $q]; :if ([:convert $s from=raw transform=sha512 to=hex]!="4e8a75e763ed5decb8a5abccc04b886728692d46d1262f834399f1045f2ef56fe2f3e50ce09966e210619e18f657f1346aae9fe5ca3401ca4a391cabfe7970ff") do={ :error "installer checksum mismatch" }; :local run [:parse $s]; $run } do={ :put ("Meridian: " . $e) } }

{
:local m7Prepare [:parse "# EXPERIMENTAL: prepares verified artifacts only. No production deployment.\n# It does not stop the VPN, change routing, install a panel or assert VPN health.\n{\n:local tag \"b15a06eb5db213e908c7d944d314c7db\"\n:local txn \"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\"\n:local suffix [:pick \$tag 0 8]\n:local owner (\"meridian-install:\" . \$tag)\n:local cname (\"m7c\" . \$suffix)\n:local veth (\"m7v\" . \$suffix)\n:local mount (\"m7m\" . \$suffix)\n:local env (\"m7e\" . \$suffix)\n:local state (\"m7s\" . \$suffix)\n:local stateAbs (\"/\" . \$state)\n:local update (\$state . \"/m7-panel-update\")\n:local updateAbs (\"/\" . \$update)\n:if ([:len \$tag]!=32 || !(\$tag~\"^[0-9a-f]+\\\$\") || [:len \$txn]!=64 || !(\$txn~\"^[0-9a-f]+\\\$\")) do={ :error \"M7UP invalid transaction\" }\n:if ([/system/resource/get architecture-name]!=\"arm64\") do={ :error \"M7UP unsupported architecture\" }\n:if ([/system/resource/get free-hdd-space]<20172892) do={ :error \"M7UP insufficient space\" }\n:local c [/container/find where name=\$cname and comment=\$owner]\n:local en [/container/envs/find where list=\$env and key=\"M7_READY_ID\"]\n:local mo [/container/mounts/find where list=\$mount and dst=\"/state\"]\n:if ([:len \$c]!=1 || [:len \$en]!=1 || [:len \$mo]!=1) do={ :error \"M7UP owner objects missing or ambiguous\" }\n:local row [/container/print detail as-value where name=\$cname and comment=\$owner]\n:if ([:len \$row]!=1 || [:tostr ((\$row->0)->\"running\")]!=\"true\" || [:tostr ((\$row->0)->\"image-id\")]!=\"3f3e5c877983cad18254874e8dc1ed07cb956ae43641af2d753341819e33536c\") do={ :error \"M7UP unexpected running image\" }\n:local id [:pick \$c 0]\n:if ([:tostr [/container/get \$id interface]]!=\$veth || [:tostr [/container/get \$id envlists]]!=\$env || [:tostr [/container/get \$id mountlists]]!=\$mount || [:tostr [/container/envs/get [:pick \$en 0] value]]!=\$tag) do={ :error \"M7UP container wiring changed\" }\n:local src [:tostr [/container/mounts/get [:pick \$mo 0] src]]\n:if ((\$src!=\$state && \$src!=\$stateAbs) || [/container/mounts/get [:pick \$mo 0] mode]!=\"rw\") do={ :error \"M7UP state mount changed\" }\n:if ([:len [/file/find where name=\$update]]!=0 || [:len [/file/find where name=\$updateAbs]]!=0) do={ :error \"M7UP update directory exists; retain and inspect\" }\n:local marker (\$tag . \":\" . \$txn . \":\" . \"58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\")\n/file/add name=\$update type=directory\n/file/add name=(\$update . \"/owner.txt\") type=file contents=\$marker\n:local fetch do={\n :local path \$1; :local url \$2; :local size \$3; :local expected \$4\n :if ([:len [/file/find where name=\$path]]!=0) do={ :error \"M7UP artifact collision\" }\n :local response [/tool/fetch url=\$url dst-path=\$path check-certificate=yes-without-crl http-max-redirect-count=0 idle-timeout=30s as-value]\n :if ((\$response->\"status\")!=\"finished\") do={ :error \"M7UP download incomplete\" }\n :local id [/file/find where name=\$path]\n :if ([:len \$id]!=1 || [/file/get [:pick \$id 0] size]!=\$size) do={ :error \"M7UP size mismatch\" }\n :local acc \"meridian-oci-v1:\"\n :local offset 0\n :while (\$offset<\$size) do={\n  :local n (\$size-\$offset); :if (\$n>32768) do={ :set n 32768 }\n  :local data ([/file/read file=\$path offset=\$offset chunk-size=\$n as-value]->\"data\")\n  :if ([:len \$data]!=\$n) do={ :error \"M7UP truncated artifact\" }\n  :set acc [:convert (\$acc . \$data) from=raw transform=sha512 to=hex]\n  :set offset (\$offset+\$n)\n }\n :if (\$acc!=\$expected) do={ :error \"M7UP checksum mismatch\" }\n}\n:onerror e in={\n \$fetch (\$update . \"/upgrade-helper\") \"https://raw.githubusercontent.com/JinComputers/meridian-linux/36f0c134fd493d7f6f0abcb7ac1d731048b63009/routeros-panel/panel-update-helper-arm64-5e2b7273f68a\" 4495000 \"55c3ca39b90d8ea5ea4938d8f611ecff16c9edc4f37e3b6a8aeee10ab9b2ca37d0c8b55f9deba5f226a411978bf64a2217b2e1d111d2015b561fdb772be0e26f\"\n \$fetch (\$update . \"/meridian-panel.new\") \"https://raw.githubusercontent.com/JinComputers/meridian-linux/45fd9389f1fced07174c36e9567adb089f273958/routeros-panel/meridian-panel-arm64-f04dd73ba50c\" 2430832 \"024053652fbc2d09b13a958a83aebca7495ccb70296163fcd8572e26256a9272443b44ab9b8d7dea387532fe95d11269c10d635e45ff3fbd8a3b012534f94c44\"\n :local manifest \"{\\\"owner\\\":\\\"b15a06eb5db213e908c7d944d314c7db\\\",\\\"panel\\\":{\\\"new\\\":\\\"f04dd73ba50cafad5ff04a08814641a0300ee03a84e5406cf09552949757daa9\\\",\\\"old\\\":\\\"7770a0e3cf1f43f75a5721336a2ae3ecf2dad1705e491647ce400de3e10605fe\\\"},\\\"transaction\\\":\\\"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\\\",\\\"version\\\":1}\"\n /file/add name=(\$update . \"/manifest.json\") type=file contents=\$manifest\n :local m7ManifestPath (\$update . \"/manifest.json\")\n :local mf [/file/find where name=\$m7ManifestPath]\n :if ([:len \$mf]!=1 || [/file/get [:pick \$mf 0] contents]!=\$manifest) do={ :error \"M7UP manifest readback\" }\n :put \"M7PANEL prepared; existing stack unchanged\"\n} do={ :error (\"M7UP preparation interrupted; owned files retained for inspection: \" . \$e) }\n}\n"]
$m7Prepare
:local m7Bootstrap [:parse "# ISOLATED LAB ONLY. Prepare executable helper; does not stage, route or commit.\n# Requires sole coordinator; no concurrent container/state mutations.\n{\n:local tag \"b15a06eb5db213e908c7d944d314c7db\"\n:local short [:pick \$tag 0 8]\n:local cname (\"m7c\" . \$short)\n:local owner (\"meridian-install:\" . \$tag)\n:local env (\"m7e\" . \$short)\n:local mounts (\"m7m\" . \$short)\n:local state (\"m7s\" . \$short)\n:local helper (\$state . \"/m7-panel-update/upgrade-helper\")\n:local done (\$state . \"/m7-panel-update/bootstrap-ready\")\n:local image \"3f3e5c877983cad18254874e8dc1ed07cb956ae43641af2d753341819e33536c\"\n:local h \"5e2b7273f68a93e8e6165dc0561b3e16f81d5067b46448e99364885d84469019\"\n:local sz 4495000\n:local chain \"55c3ca39b90d8ea5ea4938d8f611ecff16c9edc4f37e3b6a8aeee10ab9b2ca37d0c8b55f9deba5f226a411978bf64a2217b2e1d111d2015b561fdb772be0e26f\"\n:if ([:len \$tag]!=32 || !(\$tag~\"^[0-9a-f]+\\\$\") || [:len \$image]!=64 || !(\$image~\"^[0-9a-f]+\\\$\") || [:len \$h]!=64 || !(\$h~\"^[0-9a-f]+\\\$\") || [:len \$chain]!=128 || !(\$chain~\"^[0-9a-f]+\\\$\")) do={:error \"M7BOOT invalid identity\"}\n:local c [/container/find where name=\$cname and comment=\$owner]\n:local en [/container/envs/find where list=\$env and key=\"M7_READY_ID\"]\n:local mo [/container/mounts/find where list=\$mounts and dst=\"/state\"]\n:if ([:len \$c]!=1 || [:len \$en]!=1 || [:len \$mo]!=1 || [:tostr [/container/envs/get [:pick \$en 0] value]]!=\$tag) do={:error \"M7BOOT owner unverified\"}\n:local m7ContainerID [:pick \$c 0]\n:local row [/container/print detail as-value where .id=\$m7ContainerID]\n:if ([:len \$row]!=1 || [:tostr ((\$row->0)->\"image-id\")]!=\$image || [:tostr ((\$row->0)->\"running\")]!=\"true\" || [:tostr [/container/get \$m7ContainerID envlists]]!=\$env || [:tostr [/container/get \$m7ContainerID mountlists]]!=\$mounts) do={:error \"M7BOOT running container changed\"}\n:local src [:tostr [/container/mounts/get [:pick \$mo 0] src]]\n:if ((\$src!=\$state && \$src!=(\"/\" . \$state)) || [/container/mounts/get [:pick \$mo 0] mode]!=\"rw\") do={:error \"M7BOOT state mount changed\"}\n:if ([:len [/file/find where name=\$done]]!=0) do={:error \"M7BOOT stale marker\"}\n:local verify do={\n :local helper \$1; :local sz \$2; :local chain \$3\n :local f [/file/find where name=\$helper]\n :if ([:len \$f]!=1 || [/file/get [:pick \$f 0] size]!=\$sz) do={:error \"M7BOOT helper size mismatch\"}\n :local acc \"meridian-oci-v1:\"; :local offset 0\n :while (\$offset<\$sz) do={:local n (\$sz-\$offset); :if (\$n>32768) do={:set n 32768}; :local data ([/file/read file=\$helper offset=\$offset chunk-size=\$n as-value]->\"data\"); :if ([:len \$data]!=\$n) do={:error \"M7BOOT truncated\"}; :set acc [:convert (\$acc . \$data) from=raw transform=sha512 to=hex]; :set offset (\$offset+\$n)}\n :if (\$acc!=\$chain) do={:error \"M7BOOT helper chain mismatch\"}\n}\n\$verify \$helper \$sz \$chain\n# Digest is renderer-validated lowercase hex; no user text reaches this shell.\n/container/shell \$m7ContainerID cmd=\"/bin/sh -c \\\"echo '5e2b7273f68a93e8e6165dc0561b3e16f81d5067b46448e99364885d84469019  /state/m7-panel-update/upgrade-helper' | /usr/bin/sha256sum -c - && /bin/chmod 700 /state/m7-panel-update/upgrade-helper && echo '5e2b7273f68a93e8e6165dc0561b3e16f81d5067b46448e99364885d84469019  /state/m7-panel-update/upgrade-helper' | /usr/bin/sha256sum -c - && printf %s '5e2b7273f68a93e8e6165dc0561b3e16f81d5067b46448e99364885d84469019' > /state/m7-panel-update/bootstrap-ready\\\"\" no-sh\n:local ready [/file/find where name=\$done]\n:if ([:len \$ready]!=1 || [/file/get [:pick \$ready 0] contents]!=\$h) do={:error \"M7BOOT helper chmod unconfirmed\"}\n\$verify \$helper \$sz \$chain\n:put \"M7BOOT helper verified and executable; no stage\"\n}\n"]
$m7Bootstrap
:local m7Name "m7pub15a06eb"; :local m7Owner "meridian-install:b15a06eb5db213e908c7d944d314c7db:panel-update:9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a"
:if ([:len [/system/script/find where name=$m7Name]]!=0) do={:error "M7PANEL updater name collision"}
/system/script/add name=$m7Name source="# PANEL UPDATE LAB CANDIDATE. No VPN/policy/controller changes.\n{\n:local m7Tag \"b15a06eb5db213e908c7d944d314c7db\"; :local m7Tx \"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\"; :local m7Short [:pick \$m7Tag 0 8]\n:local m7Owner (\"meridian-install:\" . \$m7Tag); :local m7Name (\"m7c\" . \$m7Short); :local m7State (\"m7s\" . \$m7Short); :local m7Update (\$m7State . \"/m7-panel-update\")\n:local m7Run (\"m7pu\" . \$m7Short); :local m7Boot (\"m7pb\" . \$m7Short); :local m7Timer (\"m7pt\" . \$m7Short); :local m7Watch (\"m7pw\" . \$m7Short)\n:local m7WatchOwner (\$m7Owner . \":panel-update:\" . \$m7Tx)\n:if ([:jobname]!=\$m7Run || [:len [/system/script/find where name=\$m7Run and comment=\$m7WatchOwner]]!=1 || [:len [/system/script/job/find where script=\$m7Run]]!=1) do={:error \"M7PANEL updater identity\"}\n:local m7C [/container/find where name=\$m7Name and comment=\$m7Owner]\n:local m7Mount (\"m7m\" . \$m7Short); :local m7Env (\"m7e\" . \$m7Short); :local m7Veth (\"m7v\" . \$m7Short)\n:local m7M [/container/mounts/find where list=\$m7Mount and dst=\"/state\"]; :local m7E [/container/envs/find where list=\$m7Env and key=\"M7_READY_ID\"]\n:if ([:len \$m7C]!=1 || [:len \$m7M]!=1 || [:len \$m7E]!=1 || [/container/envs/get [:pick \$m7E 0] value]!=\$m7Tag || [:len [/system/script/find where name=\$m7Watch]]!=0 || [:len [/system/scheduler/find where name=\$m7Boot or name=\$m7Timer]]!=0) do={:error \"M7PANEL owner or watchdog collision\"}\n:local m7ID [:pick \$m7C 0]; :local m7Row [/container/print detail as-value where .id=\$m7ID]\n:local m7Src [:tostr [/container/mounts/get [:pick \$m7M 0] src]]\n:if ([:len \$m7Row]!=1 || [:tostr ((\$m7Row->0)->\"running\")]!=\"true\" || [:tostr ((\$m7Row->0)->\"image-id\")]!=\"3f3e5c877983cad18254874e8dc1ed07cb956ae43641af2d753341819e33536c\" || [:tostr [/container/get \$m7ID interface]]!=\$m7Veth || [:tostr [/container/get \$m7ID envlists]]!=\$m7Env || [:tostr [/container/get \$m7ID mountlists]]!=\$m7Mount || (\$m7Src!=\$m7State && \$m7Src!=(\"/\" . \$m7State)) || [/container/mounts/get [:pick \$m7M 0] mode]!=\"rw\" || [:tostr [/container/get \$m7ID entrypoint]]!=\"/usr/local/sbin/m7-image-entry\" || [:tostr [/container/get \$m7ID cmd]]!=\"stack\" || [:tostr [/container/get \$m7ID start-on-boot]]!=\"true\") do={:error \"M7PANEL container configuration changed\"}\n:local m7Bootstrap (\$m7Update . \"/bootstrap-ready\"); :local m7B [/file/find where name=\$m7Bootstrap]\n:if ([:len \$m7B]!=1 || [/file/get [:pick \$m7B 0] contents]!=\"5e2b7273f68a93e8e6165dc0561b3e16f81d5067b46448e99364885d84469019\") do={:error \"M7PANEL bootstrap unconfirmed\"}\n:local m7Time [/system/clock/get time]; :if (\$m7Time>23:54:00) do={:error \"M7PANEL retry after midnight\"}\n:local m7Valid do={:local m7Path \$1; :local m7Action \$2; :local m7Fs [/file/find where name=\$m7Path]; :if ([:len \$m7Fs]!=1 || [/file/get [:pick \$m7Fs 0] size]>4096) do={:return false}; :local m7R [:deserialize from=json value=[/file/get [:pick \$m7Fs 0] contents] options=json.no-string-conversion]; :return ((\$m7R->\"version\")=1 && (\$m7R->\"owner\")=\"b15a06eb5db213e908c7d944d314c7db\" && (\$m7R->\"transaction\")=\"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\" && (\$m7R->\"manifest_sha256\")=\"58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\" && (\$m7R->\"action\")=\$m7Action)}\n/system/script/add name=\$m7Watch source=\"# PANEL UPDATE LAB CANDIDATE. Retains backup, never changes routing or policy.\\n{\\n:local m7Tag \\\"b15a06eb5db213e908c7d944d314c7db\\\"; :local m7Tx \\\"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\\\"; :local m7Short [:pick \\\$m7Tag 0 8]\\n:local m7Owner (\\\"meridian-install:\\\" . \\\$m7Tag); :local m7Name (\\\"m7c\\\" . \\\$m7Short); :local m7State (\\\"m7s\\\" . \\\$m7Short)\\n:local m7Mount (\\\"m7m\\\" . \\\$m7Short); :local m7Env (\\\"m7e\\\" . \\\$m7Short); :local m7Update (\\\$m7State . \\\"/m7-panel-update\\\")\\n:local m7Run (\\\"m7pu\\\" . \\\$m7Short); :local m7Boot (\\\"m7pb\\\" . \\\$m7Short); :local m7Timer (\\\"m7pt\\\" . \\\$m7Short); :local m7Watch (\\\"m7pw\\\" . \\\$m7Short)\\n:local m7WatchOwner (\\\$m7Owner . \\\":panel-update:\\\" . \\\$m7Tx)\\n:local m7ID [:toarray \\\"\\\"]; :local m7M [:toarray \\\"\\\"]; :local m7E [:toarray \\\"\\\"]\\n:for m7Try from=1 to=40 do={\\n :set m7ID [/container/find where name=\\\$m7Name and comment=\\\$m7Owner]\\n :set m7M [/container/mounts/find where list=\\\$m7Mount and dst=\\\"/state\\\"]; :set m7E [/container/envs/find where list=\\\$m7Env and key=\\\"M7_READY_ID\\\"]\\n :if ([:len \\\$m7ID]=1 && [:len \\\$m7M]=1 && [:len \\\$m7E]=1) do={:break}; :delay 2s\\n}\\n:if ([:len \\\$m7ID]!=1 || [:len \\\$m7M]!=1 || [:len \\\$m7E]!=1 || [/container/envs/get [:pick \\\$m7E 0] value]!=\\\$m7Tag) do={:log warning \\\"M7PANEL recovery owner mismatch\\\"; :return 0}\\n:local m7ContainerID [:pick \\\$m7ID 0]; :local m7Row [/container/print detail as-value where .id=\\\$m7ContainerID]\\n:for m7Try from=1 to=30 do={:if ([:len \\\$m7Row]=1 && [:len [:tostr ((\\\$m7Row->0)->\\\"image-id\\\")]]>0) do={:break}; :delay 2s; :set m7Row [/container/print detail as-value where .id=\\\$m7ContainerID]}\\n:local m7Src [:tostr [/container/mounts/get [:pick \\\$m7M 0] src]]\\n:if ([:len \\\$m7Row]!=1 || [:tostr ((\\\$m7Row->0)->\\\"image-id\\\")]!=\\\"3f3e5c877983cad18254874e8dc1ed07cb956ae43641af2d753341819e33536c\\\" || [:tostr [/container/get \\\$m7ContainerID envlists]]!=\\\$m7Env || [:tostr [/container/get \\\$m7ContainerID mountlists]]!=\\\$m7Mount || (\\\$m7Src!=\\\$m7State && \\\$m7Src!=(\\\"/\\\" . \\\$m7State)) || [/container/mounts/get [:pick \\\$m7M 0] mode]!=\\\"rw\\\") do={:log warning \\\"M7PANEL recovery identity changed\\\"; :return 0}\\n:local m7Entry [:tostr [/container/get \\\$m7ContainerID entrypoint]]; :local m7Cmd [:tostr [/container/get \\\$m7ContainerID cmd]]\\n:if (!((\\\$m7Entry=\\\"/usr/local/sbin/m7-image-entry\\\" && \\\$m7Cmd=\\\"stack\\\") || (\\\$m7Entry=\\\"/state/m7-panel-update/upgrade-helper\\\" && (\\\$m7Cmd=\\\"stage 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\\\" || \\\$m7Cmd=\\\"recover 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\\\")))) do={:log warning \\\"M7PANEL recovery container changed\\\"; :return 0}\\n# A timer must not race the still-running owner updater. After reboot this job\\n# is gone and startup recovery can run. Identical checks are retried later.\\n:if ([:len [/system/script/job/find where script=\\\$m7Run]]>0) do={:return 0}\\n:local m7Valid do={\\n :local m7Path \\\$1; :local m7Action \\\$2; :local m7Fs [/file/find where name=\\\$m7Path]\\n :if ([:len \\\$m7Fs]!=1 || [/file/get [:pick \\\$m7Fs 0] size]>4096) do={:return false}\\n :local m7R [:deserialize from=json value=[/file/get [:pick \\\$m7Fs 0] contents] options=json.no-string-conversion]\\n :return ((\\\$m7R->\\\"version\\\")=1 && (\\\$m7R->\\\"owner\\\")=\\\"b15a06eb5db213e908c7d944d314c7db\\\" && (\\\$m7R->\\\"transaction\\\")=\\\"9969f08b88cbd4e6dadb801d321bfb914345dd789432c45828af5b502ca6a38a\\\" && (\\\$m7R->\\\"manifest_sha256\\\")=\\\"58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\\\" && (\\\$m7R->\\\"action\\\")=\\\$m7Action)\\n}\\n:onerror m7Err in={\\n :local m7Helper (\\\$m7Update . \\\"/upgrade-helper\\\"); :local m7HF [/file/find where name=\\\$m7Helper]\\n :if ([:len \\\$m7HF]!=1 || [/file/get [:pick \\\$m7HF 0] size]!=4495000) do={:error \\\"helper size changed\\\"}\\n :local m7Acc \\\"meridian-oci-v1:\\\"; :local m7Offset 0\\n :while (\\\$m7Offset<4495000) do={:local m7N (4495000-\\\$m7Offset); :if (\\\$m7N>32768) do={:set m7N 32768}; :local m7Data ([/file/read file=\\\$m7Helper offset=\\\$m7Offset chunk-size=\\\$m7N as-value]->\\\"data\\\"); :if ([:len \\\$m7Data]!=\\\$m7N) do={:error \\\"helper truncated\\\"}; :set m7Acc [:convert (\\\$m7Acc . \\\$m7Data) from=raw transform=sha512 to=hex]; :set m7Offset (\\\$m7Offset+\\\$m7N)}\\n :if (\\\$m7Acc!=\\\"55c3ca39b90d8ea5ea4938d8f611ecff16c9edc4f37e3b6a8aeee10ab9b2ca37d0c8b55f9deba5f226a411978bf64a2217b2e1d111d2015b561fdb772be0e26f\\\") do={:error \\\"helper digest changed\\\"}\\n :if ([:tostr ((\\\$m7Row->0)->\\\"running\\\")]=\\\"true\\\") do={/container/stop \\\$m7ContainerID}\\n :local m7Stopped false\\n :for m7Try from=1 to=45 do={:local m7Current [/container/print detail as-value where .id=\\\$m7ContainerID]; :if ([:len \\\$m7Current]=1 && [:tostr ((\\\$m7Current->0)->\\\"running\\\")]!=\\\"true\\\") do={:set m7Stopped true; :break}; :delay 1s}\\n :if (!\\\$m7Stopped) do={:error \\\"stop timeout\\\"}\\n /container/set \\\$m7ContainerID entrypoint=\\\"/state/m7-panel-update/upgrade-helper\\\" cmd=\\\"recover 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\\\" start-on-boot=no\\n /container/start \\\$m7ContainerID\\n :local m7Recovered false\\n :for m7Try from=1 to=60 do={:if ([\\\$m7Valid (\\\$m7Update . \\\"/recovered.json\\\") \\\"recovered\\\"]) do={:set m7Recovered true; :break}; :delay 1s}\\n :if (!\\\$m7Recovered) do={:error \\\"recovery receipt absent\\\"}\\n :local m7HelperStopped false\\n :for m7Try from=1 to=45 do={:local m7Owned [/container/find where name=\\\$m7Name and comment=\\\$m7Owner]; :local m7Current [/container/print detail as-value where .id=\\\$m7ContainerID]; :if ([:len \\\$m7Owned]!=1 || [:pick \\\$m7Owned 0]!=\\\$m7ContainerID) do={:error \\\"container identity changed\\\"}; :if ([:len \\\$m7Current]=1 && [:tostr ((\\\$m7Current->0)->\\\"running\\\")]!=\\\"true\\\") do={:set m7HelperStopped true; :break}; :delay 1s}\\n :if (!\\\$m7HelperStopped) do={:error \\\"recovery helper still running\\\"}\\n /container/set \\\$m7ContainerID entrypoint=\\\"/usr/local/sbin/m7-image-entry\\\" cmd=\\\"stack\\\" start-on-boot=no\\n /container/start \\\$m7ContainerID\\n :local m7Running false\\n :for m7Try from=1 to=60 do={:local m7Current [/container/print detail as-value where .id=\\\$m7ContainerID]; :if ([:len \\\$m7Current]=1 && [:tostr ((\\\$m7Current->0)->\\\"running\\\")]=\\\"true\\\") do={:set m7Running true; :break}; :delay 1s}\\n :if (!\\\$m7Running) do={:error \\\"old stack did not restart\\\"}\\n /container/shell \\\$m7ContainerID cmd=\\\"/state/m7-panel-update/upgrade-helper verify-old 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\\\" no-sh\\n :local m7OldVerified (\\\$m7Update . \\\"/old-verified.json\\\")\\n :if (![\\\$m7Valid \\\$m7OldVerified \\\"old-verified\\\"]) do={:error \\\"old panel unverified\\\"}\\n /container/set \\\$m7ContainerID start-on-boot=yes\\n :foreach m7Schedule in={\\\$m7Boot;\\\$m7Timer} do={:local m7S [/system/scheduler/find where name=\\\$m7Schedule and comment=\\\$m7WatchOwner]; :if ([:len \\\$m7S]=1) do={/system/scheduler/disable [:pick \\\$m7S 0]}}\\n :log warning \\\"M7PANEL previous panel restored\\\"\\n} do={:log warning (\\\"M7PANEL rollback unconfirmed: \\\" . \\\$m7Err)}\\n}\\n\" policy=ftp,read,write,test,sensitive comment=\$m7WatchOwner\n:local m7W [/system/script/find where name=\$m7Watch and comment=\$m7WatchOwner]\n:if ([:len \$m7W]!=1 || [:convert [/system/script/get [:pick \$m7W 0] source] from=raw transform=sha512 to=hex]!=\"2e777652a0282995c0dc904020aa6b5e948342244063e9fab204e3d7a6845cb80732adbaa0cc9cbcbc9a8f2137bac0f7a143d6c999bcb1685c3b86bc944b0dff\") do={:error \"M7PANEL watchdog readback\"}\n/system/scheduler/add name=\$m7Boot start-time=startup interval=0s on-event=\$m7Watch policy=ftp,read,write,test,sensitive comment=\$m7WatchOwner\n/system/scheduler/add name=\$m7Timer start-time=(\$m7Time+00:04:00) interval=1m on-event=\$m7Watch policy=ftp,read,write,test,sensitive comment=\$m7WatchOwner\n:if ([:len [/system/scheduler/find where name=\$m7Boot and comment=\$m7WatchOwner]]!=1 || [:len [/system/scheduler/find where name=\$m7Timer and comment=\$m7WatchOwner]]!=1) do={:error \"M7PANEL recovery schedule unavailable\"}\n:onerror m7Failure in={\n /container/set \$m7ID start-on-boot=no\n /container/stop \$m7ID\n :local m7Stopped false\n :for m7Try from=1 to=45 do={:local m7Current [/container/print detail as-value where .id=\$m7ID]; :if ([:len \$m7Current]=1 && [:tostr ((\$m7Current->0)->\"running\")]!=\"true\") do={:set m7Stopped true; :break}; :delay 1s}\n :if (!\$m7Stopped) do={:error \"stop timeout\"}\n /container/set \$m7ID entrypoint=\"/state/m7-panel-update/upgrade-helper\" cmd=\"stage 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\" start-on-boot=no\n /container/start \$m7ID\n :local m7Staged false\n :for m7Try from=1 to=60 do={:if ([\$m7Valid (\$m7Update . \"/staged.json\") \"staged\"]) do={:set m7Staged true; :break}; :delay 1s}\n :if (!\$m7Staged) do={:error \"stage unconfirmed\"}\n :local m7HelperStopped false\n :for m7Try from=1 to=45 do={:local m7Owned [/container/find where name=\$m7Name and comment=\$m7Owner]; :local m7Current [/container/print detail as-value where .id=\$m7ID]; :if ([:len \$m7Owned]!=1 || [:pick \$m7Owned 0]!=\$m7ID) do={:error \"container identity changed\"}; :if ([:len \$m7Current]=1 && [:tostr ((\$m7Current->0)->\"running\")]!=\"true\") do={:set m7HelperStopped true; :break}; :delay 1s}\n :if (!\$m7HelperStopped) do={:error \"stage helper still running\"}\n /container/set \$m7ID entrypoint=\"/usr/local/sbin/m7-image-entry\" cmd=\"stack\" start-on-boot=no\n /container/start \$m7ID\n :local m7Running false\n :for m7Try from=1 to=60 do={:local m7Current [/container/print detail as-value where .id=\$m7ID]; :if ([:len \$m7Current]=1 && [:tostr ((\$m7Current->0)->\"running\")]=\"true\") do={:set m7Running true; :break}; :delay 1s}\n :if (!\$m7Running) do={:error \"stack restart unconfirmed\"}\n :local m7Verified false\n :for m7Try from=1 to=8 do={/container/shell \$m7ID cmd=\"/state/m7-panel-update/upgrade-helper verify 58288a9024b460c2197f60aeb1b99213076cc024870f8f9da44d32db6bf1b4a4\" no-sh; :if ([\$m7Valid (\$m7Update . \"/verified.json\") \"verified\"]) do={:set m7Verified true; :break}; :delay 3s}\n :if (!\$m7Verified) do={:error \"panel health unconfirmed\"}\n /container/set \$m7ID start-on-boot=yes\n :foreach m7Schedule in={\$m7Boot;\$m7Timer} do={:local m7S [/system/scheduler/find where name=\$m7Schedule and comment=\$m7WatchOwner]; :if ([:len \$m7S]!=1) do={:error \"recovery schedule changed\"}; /system/scheduler/disable [:pick \$m7S 0]}\n :put \"M7PANEL updated; authenticated local panel verified; old binary retained\"\n} do={:log warning (\"M7PANEL update interrupted; automatic rollback armed: \" . \$m7Failure); :error \"M7PANEL update incomplete; automatic rollback armed\"}\n}\n" policy=ftp,read,write,test,sensitive comment=$m7Owner
:local m7S [/system/script/find where name=$m7Name and comment=$m7Owner]
:if ([:len $m7S]!=1 || [:convert [/system/script/get [:pick $m7S 0] source] from=raw transform=sha512 to=hex]!="c3bd22ca2cb9fd2be78b03973d4383c8ee8b8ce904b92de7aadfba69b2e2cbd79e2736d903b9091d2007f631395227b30d74a96ba1984b6d8f2c4871838759a5") do={:error "M7PANEL updater source mismatch"}
